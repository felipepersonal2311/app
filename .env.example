# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env nunca deve ser commitado (ele já está no .gitignore).

# Chave usada para proteger sessões e formulários. Troque por um valor aleatório longo.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Usuário e senha do painel administrativo (/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Número de WhatsApp para onde os pedidos são enviados.
# Formato: 55 + DDD + número, sem espaços, traços ou o sinal de "+".
WHATSAPP_NUMBER=5561996994875

# Nome exibido no site e no painel.
STORE_NAME=Nome da Loja

# --- Supabase (banco de dados + fotos dos produtos) ---
# Se deixar essas variáveis em branco, o site usa um banco SQLite local
# (arquivo instance/loja.db) — ótimo para rodar na sua máquina, mas não
# funciona em hospedagens "serverless" como a Vercel.

# Postgres do Supabase. Use a "Connection pooling" string (modo Transaction,
# porta 6543) em Project Settings > Database > Connection pooling — não a
# conexão direta, porque hospedagens serverless abrem muitas conexões de
# uma vez e o pooler é feito pra aguentar isso.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Project Settings > API > service_role secret key.
# ATENÇÃO: essa chave dá acesso total ao projeto Supabase. Nunca coloque ela
# no código, no navegador ou em qualquer lugar público — só como variável de
# ambiente do servidor.
SUPABASE_SERVICE_ROLE_KEY=troque-pela-service-role-key

# Nome do bucket de Storage (criado como "público") onde as fotos ficam salvas.
SUPABASE_STORAGE_BUCKET=product-images
